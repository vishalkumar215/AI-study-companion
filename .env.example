# Copy this file to .env and fill in the values.
DATABASE_URL="file:./prisma/dev.db"

# Any long random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="replace-with-a-long-random-string"

# Free key from https://aistudio.google.com/apikey
# Leave empty to run the app in local demo mode (no AI calls).
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional SMTP for password-reset emails. In development the OTP is shown
# on the forgot-password page when SMTP is not configured.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="StudyMate AI <noreply@studymate.test>"

# Optional: live Google Search grounding for Research (billed Gemini plan).
# RESEARCH_WEB_SEARCH="false"
